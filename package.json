{
  "name": "flight-booking-service",
  "version": "1.0.0",
  "description": "Production-grade flight booking service with concurrency safety, idempotency, and JWT authentication",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "npx nodemon src/index.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:migrate:test": "npx sequelize-cli db:migrate --env test",
    "db:seed:test": "npx sequelize-cli db:seed:all --env test",
    "seed:realistic": "node scripts/generate-realistic-data.js",
    "explain": "node scripts/run-explain-analysis.js",
    "benchmark": "node scripts/benchmark-load.js"
  },
  "author": "Atul Rana",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.2.4",
    "nodemon": "^2.0.22",
    "sequelize": "^6.31.1",
    "sequelize-cli": "^6.6.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
